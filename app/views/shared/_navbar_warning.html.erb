<%# The one banner that sits above every signed-in page: the account is
    suspended, so nothing new can be created until the payment is settled.
    Shown to EVERY user of the account, not only the admin — the person who
    finds their "New document" button refusing needs to know why, even though
    only an admin can act on it. `read_only?` covers being billed through a
    suspended parent as well as being suspended directly. %>
<% if signed_in? && AccountStates.read_only?(current_account) %>
  <div class="max-w-6xl mx-auto px-4 md:px-2 pt-3">
    <div class="alert items-start bg-base-100 border border-red-400 text-red-400" data-account-suspended-banner>
      <%= svg_icon('alert_circle', class: 'stroke-current shrink-0 h-6 w-6 mt-0.5') %>
      <div dir="auto" class="text-sm space-y-1">
        <p class="font-semibold"><%= t('account_suspended_banner') %></p>
        <p><%= t('account_suspended_banner_hint') %></p>
        <p>
          <%= link_to t('account_suspended_banner_link'), settings_billing_path,
                      class: 'link font-semibold', data: { account_suspended_link: true } %>
        </p>
      </div>
    </div>
  </div>
<% end %>
