<%# The settings navigation is two shapes, not two markups. From `md` up it is
    the sidebar it has always been. Below `md` the same list turns into a
    horizontal strip of tabs that scrolls sideways, because stacked vertically
    it pushed the actual settings a full phone-screen-and-a-half down the page
    (checkpoint 9, D2/1). The "Back" arrow and the "Settings" caption are
    sidebar furniture and stand down on a phone: the logo in the navbar is the
    way out, and the page's own heading already says where you are. %>
<div class="block w-full md:w-52 flex-none">
  <menu-active class="settings-tabs block">
    <ul id="account_settings_menu"
        class="menu px-0 menu-horizontal md:menu-vertical flex-nowrap md:flex-wrap w-full
               whitespace-nowrap md:whitespace-normal overflow-x-auto md:overflow-visible
               border-b border-base-300 md:border-b-0 pb-1 md:pb-0">
      <li class="menu-title py-0 !bg-transparent mb-3 -mt-5 hidden md:block"><a href="<%= '/' %>" class="!bg-transparent !text-neutral font-medium flex items-center space-x-0.5"><%= svg_icon('arrow_left', class: 'w-4 h-4 stroke-2') %><span><%= t('back') %></span></a></li>
      <li class="menu-title py-0 !bg-transparent hidden md:block">
        <span class="!bg-transparent"><%= t('settings') %></span>
      </li>
      <li class="hidden md:block"></li>
      <li>
        <%= link_to t('profile'), settings_profile_index_path, class: 'text-base hover:bg-base-300' %>
      </li>
      <% if can?(:administer, current_account) %>
        <li>
          <%= link_to t('account'), settings_account_path, class: 'text-base hover:bg-base-300' %>
        </li>
        <li>
          <%= link_to t('usage'), settings_usage_path, class: 'text-base hover:bg-base-300' %>
        </li>
        <%# Billing sits next to Usage and only for someone who could act on it: the switch on, a customer account, and an admin of it. %>
        <% if billing_available? %>
          <li>
            <%= link_to t('billing'), settings_billing_path, class: 'text-base hover:bg-base-300' %>
          </li>
        <% end %>
      <% end %>
      <%# Per-account SMTP is a paid row: the entry stays discoverable for everyone who may read the config (the page renders the upgrade CTA when the plan lacks it). %>
      <% if can?(:read, EncryptedConfig.new(key: EncryptedConfig::EMAIL_SMTP_KEY, account: current_account)) && true_user == current_user %>
        <li>
          <%= link_to t('email'), settings_email_index_path, class: 'text-base hover:bg-base-300' %>
        </li>
      <% end %>
      <% if can?(:read, AccountConfig) %>
        <li>
          <%= link_to t('notifications'), settings_notifications_path, class: 'text-base hover:bg-base-300' %>
        </li>
      <% end %>
      <% if can?(:read, EncryptedConfig.new(key: EncryptedConfig::ESIGN_CERTS_KEY, account: current_account)) %>
        <li>
          <%= link_to t('e_signature'), settings_esign_path, class: 'text-base hover:bg-base-300' %>
        </li>
      <% end %>
      <% if can?(:read, AccountConfig) %>
        <li>
          <%= link_to t('personalization'), settings_personalization_path, class: 'text-base hover:bg-base-300' %>
        </li>
      <% end %>
      <% if can?(:administer, current_account) %>
        <li>
          <%= link_to t('users'), settings_users_path, class: 'text-base hover:bg-base-300' %>
        </li>
      <% end %>
      <%# Taking everything with you. Keyed on `:export` rather than
          `:administer` because they are not the same door: a support session
          keeps the second and loses the first. %>
      <% if can?(:export, current_account) %>
        <li>
          <%= link_to t('export'), settings_account_export_path, class: 'text-base hover:bg-base-300' %>
        </li>
      <% end %>
      <%= render 'shared/settings_nav_extra' %>
      <%# API and Webhooks are paid rows shown to everyone (conversion): their pages render the upgrade CTA when the plan lacks them. %>
      <% if can?(:read, AccessToken) %>
        <li>
          <%= link_to 'API', settings_api_index_path, class: 'text-base hover:bg-base-300' %>
        </li>
      <% end %>
      <% if can?(:read, WebhookUrl) %>
        <li>
          <%= link_to 'Webhooks', settings_webhooks_path, class: 'text-base hover:bg-base-300' %>
        </li>
      <% end %>
      <% if !Docuseal.demo? && can?(:manage, EncryptedConfig) && (current_user == true_user || current_account.testing?) %>
        <% if can?(:read, McpToken) && can?(:manage, :mcp) %>
          <li>
            <%= link_to 'MCP', settings_mcp_index_path, class: 'text-base hover:bg-base-300' %>
          </li>
        <% end %>
        <%= render 'shared/settings_nav_extra2' %>
        <% if test_mode_available? && ((can?(:manage, EncryptedConfig) && current_user == true_user) || (current_user != true_user && current_account.testing?)) %>
          <%= form_for '', url: testing_account_path, method: current_account.testing? ? :delete : :post, html: { class: 'w-auto md:w-full' } do |f| %>
            <li>
              <label class="flex items-center text-base hover:bg-base-300 w-auto md:w-full justify-between" for="testing_toggle">
                <span class="mr-2 w-auto md:w-full">
                  <%= t('test_mode') %>
                </span>
                <submit-form data-on="change" class="flex">
                  <%= f.check_box :testing_toggle, class: 'toggle toggle-sm', checked: current_account.testing? %>
                </submit-form>
              </label>
            </li>
          <% end %>
        <% end %>
      <% end %>
    </ul>
  </menu-active>
  <div id="support_channels" class="mx-4 border-t border-base-300 hidden md:block">
      <%# Support is an email address, not a public issue tracker: this is a
          paid product and the customer writes to us directly. %>
      <div class="text-sm mt-3">
        <%= t('need_help_email_us') %>
      </div>
      <a href="mailto:<%= Docuseal::SUPPORT_EMAIL %>" class="w-full block mt-2 underline text-center">
        <%= Docuseal::SUPPORT_EMAIL %>
      </a>
      <%# The running version is platform information: operator-only. %>
      <% if Docuseal.version.present? && operator_access? %>
        <a href="<%= Docuseal::GITHUB_URL %>/releases" target="_blank" class="badge badge-outline text-xs block mx-auto mt-4">
          v<%= Docuseal.version %>
        </a>
      <% end %>
    </div>
</div>
