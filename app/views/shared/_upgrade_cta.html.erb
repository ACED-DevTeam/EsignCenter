<%# Upgrade call-to-action: rendered wherever a PAID-ONLY surface is shown to an account whose plan lacks it (the server refuses the matching POST regardless — this is the friendly face of that refusal). Locals: feature (display name, required); body (optional sentence overriding the default copy); compact (optional, true renders a one-line banner for the SECOND gated surface on a page so two full cards never stack). The link is a placeholder until Session 6 wires the real Checkout URL onto [data-upgrade-cta]. %>
<% feature = local_assigns.fetch(:feature) %>
<% if local_assigns[:compact] %>
  <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-4 rounded-2xl bg-base-200 border border-base-300 px-4 py-3 <%= local_assigns[:class] %>" data-upgrade-cta-compact>
    <div class="flex items-center gap-3 flex-1 min-w-0">
      <div class="flex-none w-8 h-8 rounded-xl bg-neutral text-white flex items-center justify-center">
        <%= svg_icon('sparkles', class: 'w-4 h-4') %>
      </div>
      <p class="text-sm min-w-0" dir="auto">
        <span class="font-semibold"><%= t('this_feature_requires_a_paid_plan') %>.</span>
        <span class="text-base-content/70"><%= local_assigns[:body] || t('feature_is_available_on_the_paid_plan', feature:) %></span>
      </p>
    </div>
    <a href="#" class="btn btn-neutral btn-sm text-white w-full sm:w-auto flex-none gap-1" data-upgrade-cta>
      <span><%= t('upgrade_plan') %></span>
      <%= svg_icon('arrow_right', class: 'w-4 h-4') %>
    </a>
  </div>
<% else %>
  <div class="card bg-base-200 border border-base-300 <%= local_assigns[:class] %>">
    <div class="card-body p-5 md:p-6 flex flex-col md:flex-row md:items-center gap-4 md:gap-6">
      <div class="flex items-start md:items-center gap-4 flex-1 min-w-0">
        <div class="flex-none w-12 h-12 rounded-2xl bg-neutral text-white flex items-center justify-center">
          <%= svg_icon('sparkles', class: 'w-6 h-6') %>
        </div>
        <div class="min-w-0">
          <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
            <p class="text-lg font-semibold leading-tight"><%= t('this_feature_requires_a_paid_plan') %></p>
            <span class="badge badge-neutral badge-outline badge-sm"><%= t('paid_plan') %></span>
          </div>
          <p class="text-sm text-base-content/70 mt-1" dir="auto">
            <%= local_assigns[:body] || safe_join([t('feature_is_available_on_the_paid_plan', feature:), t('upgrade_to_unlock_this_and_every_other_paid_feature')], ' ') %>
          </p>
        </div>
      </div>
      <a href="#" class="btn btn-neutral text-white w-full md:w-auto flex-none gap-2" data-upgrade-cta>
        <span><%= t('upgrade_plan') %></span>
        <%= svg_icon('arrow_right', class: 'w-5 h-5') %>
      </a>
    </div>
  </div>
<% end %>
