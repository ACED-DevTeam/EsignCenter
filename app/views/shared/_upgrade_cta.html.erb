<%# Upgrade call-to-action: rendered wherever a PAID-ONLY surface is shown to an account whose plan lacks it (the server refuses the matching POST regardless — this is the friendly face of that refusal). Locals: feature (display name, required); body (optional sentence overriding the default copy); title (optional heading for a non-feature context such as the usage page or a full seat count, default "This feature requires a paid plan" — honoured by both variants); compact (optional, true renders a one-line banner for the SECOND gated surface on a page so two full cards never stack); dismiss_path (optional, adds a × beside the button that DELETEs to that path — for a card the person is offered once rather than one that stands for a refusal); dismiss_data (optional data attributes for that button). [data-upgrade-cta] points at the billing page whenever billing is switched on and the signed-in user could actually buy (a customer account, admin); otherwise it points at the usage page, so the link is never dead. %>
<%# `feature` is required exactly when the default copy needs it: a caller that supplies its own `body` (the first-completion nudge, which is not a refusal at all) has nothing to name. %>
<% default_body = -> { safe_join([t('feature_is_available_on_the_paid_plan', feature: local_assigns.fetch(:feature)), t('upgrade_to_unlock_this_and_every_other_paid_feature')], ' ') } %>
<% upgrade_path = upgrade_cta_path %>
<% dismiss_path = local_assigns[:dismiss_path] %>
<% if local_assigns[:compact] %>
  <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-4 rounded-2xl bg-base-200 border border-base-300 px-4 py-3 <%= local_assigns[:class] %>" data-upgrade-cta-compact>
    <div class="flex items-center gap-3 flex-1 min-w-0">
      <div class="flex-none w-8 h-8 rounded-xl bg-neutral text-white flex items-center justify-center">
        <%= svg_icon('sparkles', class: 'w-4 h-4') %>
      </div>
      <p class="text-sm min-w-0" dir="auto">
        <span class="font-semibold"><%= local_assigns[:title] || t('this_feature_requires_a_paid_plan') %>.</span>
        <span class="text-base-content/70"><%= local_assigns[:body] || t('feature_is_available_on_the_paid_plan', feature: local_assigns.fetch(:feature)) %></span>
      </p>
    </div>
    <a href="<%= upgrade_path %>" class="btn btn-neutral btn-sm text-white w-full sm:w-auto flex-none gap-1" data-upgrade-cta>
      <span><%= t('upgrade_plan') %></span>
      <%= svg_icon('arrow_right', class: 'w-4 h-4') %>
    </a>
  </div>
<% else %>
  <div class="card bg-base-200 border border-base-300 <%= local_assigns[:class] %>">
    <div class="card-body p-5 md:p-6 flex flex-col md:flex-row md:items-center gap-4 md:gap-6">
      <div class="flex items-start md:items-center gap-4 flex-1 min-w-0">
        <div class="flex-none w-12 h-12 rounded-2xl bg-neutral text-white flex items-center justify-center">
          <%= svg_icon('sparkles', class: 'w-6 h-6') %>
        </div>
        <div class="min-w-0">
          <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
            <p class="text-lg font-semibold leading-tight" dir="auto"><%= local_assigns[:title] || t('this_feature_requires_a_paid_plan') %></p>
            <% unless dismiss_path %>
              <span class="badge badge-neutral badge-outline badge-sm"><%= t('paid_plan') %></span>
            <% end %>
          </div>
          <p class="text-sm text-base-content/70 mt-1" dir="auto">
            <%= local_assigns[:body] || default_body.call %>
          </p>
        </div>
      </div>
      <div class="flex items-center gap-2 w-full md:w-auto flex-none">
        <a href="<%= upgrade_path %>" class="btn btn-neutral text-white <%= dismiss_path ? 'flex-1' : 'w-full' %> md:w-auto md:flex-none gap-2" data-upgrade-cta>
          <span><%= t('upgrade_plan') %></span>
          <%= svg_icon('arrow_right', class: 'w-5 h-5') %>
        </a>
        <% if dismiss_path %>
          <%= button_to dismiss_path, method: :delete, class: 'btn btn-ghost btn-sm btn-circle flex-none', form_class: 'inline', 'aria-label': t('dismiss'), title: t('dismiss'), data: local_assigns.fetch(:dismiss_data, {}) do %>
            <%= svg_icon('x', class: 'w-5 h-5') %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
