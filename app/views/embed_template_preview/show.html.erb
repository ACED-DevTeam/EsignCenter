<%# Read-only template preview for an embedding app. Deliberately carries no
    link into the signing app's authenticated screens — the viewer is a guest of
    the host product and has no session here. %>
<% banner_html = capture do %>
  <div class="sticky top-0 z-50 bg-base-100 py-2 px-2 flex items-center" style="margin: 0px -8px -16px -8px">
    <div class="text-xl md:text-3xl font-semibold focus:text-clip" style="width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
      <%= @template.name %>
    </div>
  </div>
<% end %>
<%= render template: 'submit_form/show', locals: { dry_run: true, expand: false, banner_html:, scroll_padding: '-120px', esign_consent_pdf_url: embed_template_preview_document_path(token: params[:token]) } %>
