<%# One console action: a button, and behind it a dialog that asks for the
    reason before it will do anything. The reason is not paperwork — it is
    what the audit log shows the next person who asks why this account was
    frozen — so it is required and it is the only field most actions have.
    Locals: key, url, label, hint, button_class, confirm_class. %>
<% uuid = "operator_action_#{key}" %>
<modal-button data-target="<%= uuid %>" class="flex">
  <button class="btn btn-sm <%= local_assigns.fetch(:button_class, 'btn-outline') %>" data-operator-action="<%= key %>">
    <%= label %>
  </button>
</modal-button>
<%= render 'shared/html_modal', title: label, uuid: uuid do %>
  <%= form_with url: url, method: :post, data: { turbo: false }, class: 'space-y-4' do %>
    <p class="text-sm text-base-content/70"><%= hint %></p>
    <% if local_assigns[:extra_field] == 'confirm_name' %>
      <label class="form-control">
        <span class="label-text mb-1"><%= t('operator_confirm_name_label') %></span>
        <input type="text" name="confirm_name" class="input input-bordered w-full" autocomplete="off" required>
        <span class="label-text-alt mt-1"><%= t('operator_confirm_name_hint', name: @account.name) %></span>
      </label>
    <% end %>
    <label class="form-control">
      <span class="label-text mb-1"><%= t('operator_reason_label') %></span>
      <textarea name="reason" rows="3" class="textarea textarea-bordered w-full" required minlength="<%= Operator::BaseController::MINIMUM_REASON_LENGTH %>"></textarea>
    </label>
    <div class="flex justify-end gap-2">
      <button type="submit" class="btn <%= local_assigns.fetch(:confirm_class, 'btn-primary') %>"><%= label %></button>
    </div>
  <% end %>
<% end %>
