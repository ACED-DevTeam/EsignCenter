<%# The start door for a support session. Three things before anything happens:
    the reason the customer will read, the mode (read-only unless somebody
    deliberately chooses otherwise), and the operator's live authenticator code
    — operator access is a property of a login that may have been open all day,
    and stepping inside a customer's account is not something a borrowed laptop
    should be able to do. Locals: user. %>
<% uuid = "operator_impersonate_#{user.id}" %>
<modal-button data-target="<%= uuid %>" class="flex">
  <button class="btn btn-xs btn-outline" data-operator-impersonate="<%= user.id %>">
    <%= t('support_impersonation_start_button') %>
  </button>
</modal-button>
<%= render 'shared/html_modal', title: t('support_impersonation_start_title', email: user.email), uuid: uuid do %>
  <%= form_with url: operator_impersonations_path, method: :post, data: { turbo: false }, class: 'space-y-4' do %>
    <%= hidden_field_tag :account_id, @account.id %>
    <%= hidden_field_tag :user_id, user.id %>
    <p class="text-sm text-base-content/70"><%= t('support_impersonation_start_hint') %></p>
    <label class="form-control">
      <span class="label-text mb-1"><%= t('operator_reason_label') %></span>
      <textarea name="reason" rows="3" class="textarea textarea-bordered w-full" required
                minlength="<%= SupportImpersonation::MINIMUM_REASON_LENGTH %>"></textarea>
      <span class="label-text-alt mt-1"><%= t('support_impersonation_reason_hint') %></span>
    </label>
    <fieldset class="space-y-2">
      <legend class="label-text mb-1"><%= t('support_impersonation_mode_label') %></legend>
      <label class="flex items-start gap-2">
        <input type="radio" name="mode" value="<%= SupportImpersonation::READ_ONLY_MODE %>" class="radio radio-sm mt-0.5" checked>
        <span>
          <span class="font-medium"><%= t('support_impersonation_mode_read_only') %></span>
          <span class="block text-sm text-base-content/70"><%= t('support_impersonation_mode_read_only_hint') %></span>
        </span>
      </label>
      <label class="flex items-start gap-2">
        <input type="radio" name="mode" value="<%= SupportImpersonation::EDIT_MODE %>" class="radio radio-sm mt-0.5">
        <span>
          <span class="font-medium"><%= t('support_impersonation_mode_edit') %></span>
          <span class="block text-sm text-base-content/70"><%= t('support_impersonation_mode_edit_hint') %></span>
        </span>
      </label>
    </fieldset>
    <label class="form-control">
      <span class="label-text mb-1"><%= t('support_impersonation_code_label') %></span>
      <input type="text" name="otp_attempt" class="input input-bordered w-full font-mono" required
             inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]*" maxlength="6">
      <span class="label-text-alt mt-1"><%= t('support_impersonation_code_hint') %></span>
    </label>
    <div class="flex justify-end gap-2">
      <button type="submit" class="btn btn-primary"><%= t('support_impersonation_start_button') %></button>
    </div>
  <% end %>
<% end %>
