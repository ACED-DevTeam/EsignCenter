<%# The one-time upgrade nudge after a free account's first signed document
    (D50). Armed by Quotas.arm_first_completion_prompt, shown to that
    account's administrators until one of them dismisses it. The button uses
    the shared upgrade_cta_path helper, so it lands on billing where billing
    exists and on the usage page otherwise — never on a refusal, never on a
    dead link. %>
<% prompt = FirstCompletionPrompt.for(account: current_account, user: current_user) %>
<% if prompt %>
  <div class="card bg-base-200 border border-base-300 mb-6" data-first-completion-prompt>
    <div class="card-body p-5 md:p-6 flex flex-col md:flex-row md:items-center gap-4 md:gap-6">
      <div class="flex items-start md:items-center gap-4 flex-1 min-w-0">
        <div class="flex-none w-12 h-12 rounded-2xl bg-neutral text-white flex items-center justify-center">
          <%= svg_icon('sparkles', class: 'w-6 h-6') %>
        </div>
        <div class="min-w-0">
          <p class="text-lg font-semibold leading-tight" dir="auto"><%= t('first_completion_prompt_title') %></p>
          <p class="text-sm text-base-content/70 mt-1" dir="auto"><%= t('first_completion_prompt_body', limit: Quotas::Limits::FREE_COMPLETIONS_PER_MONTH) %></p>
        </div>
      </div>
      <div class="flex items-center gap-2 flex-none w-full md:w-auto">
        <a href="<%= upgrade_cta_path %>" class="btn btn-neutral text-white flex-1 md:flex-none gap-2" data-upgrade-cta>
          <span><%= t('upgrade_plan') %></span>
          <%= svg_icon('arrow_right', class: 'w-5 h-5') %>
        </a>
        <%= button_to first_completion_prompt_path, method: :delete, class: 'btn btn-ghost btn-sm btn-circle flex-none', form_class: 'inline', 'aria-label': t('dismiss'), title: t('dismiss'), data: { first_completion_dismiss: true } do %>
          <%= svg_icon('x', class: 'w-5 h-5') %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
