<% content_for(:html_title, "#{@template.name} — EsignCenter") %>
<% content_for(:html_description, t('form_not_accepting_responses')) %>
<main class="max-w-md mx-auto px-2 mt-12 mb-4">
  <div class="space-y-6 mx-auto">
    <div class="flex items-center justify-center">
      <%= render 'start_form/banner' %>
    </div>
    <div class="flex items-center bg-base-200 rounded-xl p-4">
      <div class="mr-3">
        <%= svg_icon('writing_sign', class: 'w-10 h-10') %>
      </div>
      <div dir="auto">
        <p class="text-lg font-bold mb-1"><%= @template.name %></p>
        <p class="text-sm"><%= t('form_not_accepting_responses') %></p>
      </div>
    </div>
    <% if @quota_sender_view %>
      <div class="alert items-start bg-base-100 border border-red-400 text-red-400">
        <%= svg_icon('info_circle', class: 'stroke-current shrink-0 h-6 w-6 mt-1') %>
        <div dir="auto" class="text-sm space-y-2">
          <p><%= @quota_message %></p>
          <p><a href="<%= Quotas::USAGE_PATH %>" class="link font-semibold" data-upgrade-cta><%= t('upgrade_to_send_more') %></a></p>
        </div>
      </div>
    <% else %>
      <p dir="auto" class="text-center text-base-content/80">
        <%= t('form_not_accepting_responses_hint') %>
      </p>
    <% end %>
  </div>
</main>
<%= render 'shared/attribution', account: @template.account %>
