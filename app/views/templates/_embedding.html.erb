<div class="my-4">
  <div class="mockup-code overflow-hidden pb-0">
    <% text = capture do %><script src="<%= embed_script_url(filename: 'form.js') %>" async></script>

<esigncenter-form data-src="<%= start_form_url(slug: template.slug) %>"></esigncenter-form><% end.to_str %>
    <span class="top-0 right-0 absolute">
      <%= render 'shared/clipboard_copy', icon: 'copy', text:, class: 'btn btn-ghost text-white', icon_class: 'w-6 h-6 text-white', copy_title: t('copy'), copied_title: t('copied') %>
    </span>
    <pre class="before:!m-0 pl-6 pb-4 overflow-auto"><code class="overflow-hidden w-full"><span style="color: #f4bf75">&lt;script </span><span style="color: #6a9fb5">src=</span><span style="color: #90a959">"<%= embed_script_url(filename: 'form.js') %>"</span> <span style="color: #6a9fb5">async</span><span style="color: #f4bf75">&gt;&lt;/script&gt;</span>

<span style="color: #f4bf75">&lt;esigncenter-form</span> <span style="color: #6a9fb5">data-src=</span><span style="color: #90a959">"<%= start_form_url(slug: template.slug) %>"</span><span style="color: #f4bf75">&gt;&lt;/esigncenter-form&gt;</span>
</code></pre>
  </div>
  <p class="text-sm text-neutral-500 mt-2">
    <span class="capitalize"><%= t('optional') %></span>:
    <span class="font-mono break-words">data-email, data-name, data-role, data-token, data-preview, data-expand, data-minimize, data-completed-redirect-url, data-height, data-title</span>
  </p>
</div>
