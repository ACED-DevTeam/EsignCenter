<%# One usage card: `used` and `limit` are numbers (limit nil = unlimited); `used_text`/`limit_text` are what the human reads; a blank `limit_text` (storage) shows the amount and the bar without naming the cap. Over the cap the bar is full and the badge says so — the number is never clamped. `full_is_neutral` (seats): exactly at the limit is the ordinary state, shown neutral; only past it is red. %>
<% limit = local_assigns[:limit] %>
<% full_is_neutral = local_assigns[:full_is_neutral] %>
<% over = limit.present? && (full_is_neutral ? used > limit : used >= limit) %>
<% full = full_is_neutral && limit.present? && !over && used >= limit %>
<% percent = limit.present? && limit.positive? ? [(used * 100.0 / limit).round, 100].min : nil %>
<div class="card bg-base-100 border border-base-300" data-usage-card="<%= key %>">
  <div class="card-body p-5 gap-3">
    <div class="flex items-start justify-between gap-3">
      <div class="flex items-center gap-3 min-w-0">
        <div class="flex-none w-10 h-10 rounded-xl bg-base-200 flex items-center justify-center">
          <%= svg_icon(icon, class: 'w-5 h-5') %>
        </div>
        <p class="font-semibold leading-tight" dir="auto"><%= title %></p>
      </div>
      <% if over %>
        <span class="badge badge-error badge-outline whitespace-nowrap flex-none" data-limit-reached><%= t('limit_reached') %></span>
      <% elsif full %>
        <span class="badge badge-neutral badge-outline whitespace-nowrap flex-none" data-all-seats-in-use><%= t('all_seats_in_use') %></span>
      <% end %>
    </div>
    <p class="text-3xl font-bold tabular-nums" dir="auto">
      <% if limit.present? && local_assigns[:limit_text].present? %>
        <%= t('usage_of', used: used_text, limit: limit_text) %>
      <% else %>
        <%= used_text %>
      <% end %>
    </p>
    <% if percent %>
      <progress class="progress w-full <%= over ? 'progress-error' : 'progress-primary' %>" value="<%= percent %>" max="100" aria-label="<%= title %>"></progress>
    <% end %>
    <% if local_assigns[:hint].present? %>
      <p class="text-sm text-base-content/70" dir="auto"><%= hint %></p>
    <% end %>
  </div>
</div>
