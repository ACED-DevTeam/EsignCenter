<div class="flex-wrap space-y-4 md:flex md:flex-nowrap md:space-y-0 md:space-x-10">
  <%= render 'shared/settings_nav' %>
  <div class="md:flex-grow">
    <div class="flex flex-col md:flex-row md:flex-wrap gap-2 md:justify-between md:items-end mb-4 min-h-12">
      <h1 class="text-4xl font-bold">
        <% if params[:status] == 'archived' %>
          <%= t('archived_users') %>
        <% elsif params[:status] == 'integration' %>
          <%# D78(e): "Embedding Users" was the upstream name. These rows are
              the legacy API-only logins the import left behind, and the page
              is named the same as the badge on every one of them. %>
          <%= t('integration_users') %>
        <% else %>
          <%= t('users') %>
        <% end %>
      </h1>
      <div class="flex flex-col md:flex-row gap-y-2 gap-x-4 md:items-center">
        <%# A free account whose seats are all taken has no "add a user" to
            offer: the server refuses the invitation, and on the free plan
            there is no seat to buy either. So the button is replaced by the
            one thing that would actually work — the upgrade. A PAID account
            at its seat count keeps the button: there the refusal turns into
            a priced offer for one more seat. %>
        <% can_add_user = can?(:create, User.new(account: current_account)) %>
        <% seat_limit = Plans.seats_for(current_account) %>
        <% seats_sold_out = can_add_user && seat_limit.present? &&
                            Plans.key_for(current_account) == Plans::FREE &&
                            Accounts.seat_occupancy(current_account) >= seat_limit %>
        <% if params[:status].blank? && seats_sold_out %>
          <%= render 'shared/upgrade_cta', feature: t('users'), title: t('all_seats_in_use'),
                                           body: t('upgrade_to_add_more_users'), compact: true %>
        <% elsif params[:status].blank? %>
          <% if can_add_user %>
            <%= render 'users/extra_buttons' %>
            <% if content_for(:add_user_button) %>
              <%= content_for(:add_user_button) %>
            <% else %>
              <%= link_to new_user_path, class: 'btn btn-primary btn-md gap-2 w-full md:w-fit', data: { turbo_frame: 'modal' } do %>
                <%= svg_icon('plus', class: 'w-6 h-6') %>
                <span><%= t('new_user') %></span>
              <% end %>
            <% end %>
          <% else %>
            <div class="tooltip" data-tip="<%= t('contact_your_administrator_to_add_new_users') %>">
              <%= link_to '#', class: 'btn btn-primary btn-md gap-2 w-full md:w-fit btn-disabled', data: { turbo_frame: 'modal' } do %>
                <%= svg_icon('plus', class: 'w-6 h-6') %>
                <span><%= t('new_user') %></span>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
    <%# D78(e): the API-only logins the original import left behind. The list
        says what they can and cannot do, and what replaces them, so nobody has
        to guess why one of these rows cannot open Settings. %>
    <% if params[:status] == 'integration' %>
      <p class="text-base-content/70 mb-4" dir="auto" data-integration-users-help><%= t('integration_users_help') %></p>
    <% end %>
    <%# A five-column table is 640px wide and a phone is 390 (checkpoint 9,
        D2/2): sideways-scrolling a table hides the row's actions behind an
        edge with nothing to say they are there. Below `md` each teammate is a
        card with their buttons underneath, the same shape the pending
        invitations below already use; the table starts at `md`. %>
    <ul class="md:hidden space-y-3">
      <% @users.each do |user| %>
        <li class="rounded-2xl border border-base-300 bg-base-100 p-4" data-user-card="<%= user.id %>">
          <p dir="auto" class="font-medium"><%= user.full_name %></p>
          <p dir="auto" class="mt-1 text-sm text-base-content/70 break-all">
            <% if user.try(:pending_reconfirmation?) %>
              <%= user.unconfirmed_email %>
              <span class="label-text-alt">(<%= t('unconfirmed') %>)</span>
            <% else %>
              <%= user.email %>
            <% end %>
          </p>
          <p class="mt-1 text-sm text-base-content/70">
            <%= t('last_session') %>:
            <%= user.current_sign_in_at ? l(user.current_sign_in_at.in_time_zone(current_account.timezone), format: :short, locale: current_account.locale) : '-' %>
          </p>
          <div class="mt-3 flex flex-wrap items-center gap-2">
            <span class="badge badge-info badge-outline whitespace-nowrap"><%= t(user.role) %></span>
            <% if user.read_only? %>
              <span class="badge badge-ghost whitespace-nowrap"><%= t('read_only') %></span>
            <% end %>
          </div>
          <div class="mt-3 flex flex-wrap items-center gap-2">
            <%= render 'users/row_actions', user: %>
          </div>
        </li>
      <% end %>
    </ul>
    <div class="hidden md:block overflow-x-auto">
      <table class="table w-full table-lg rounded-b-none overflow-hidden">
        <thead class="bg-base-200">
          <tr class="text-neutral uppercase">
            <th>
              <%= t('name') %>
            </th>
            <th>
              <%= t('email') %>
            </th>
            <th>
              <%= t('role') %>
            </th>
            <th>
              <%= t('last_session') %>
            </th>
            <th class="text-right" width="1px">
            </th>
          </tr>
        </thead>
        <tbody>
          <% @users.each do |user| %>
            <tr scope="row">
              <td>
                <%= user.full_name %>
              </td>
              <td>
                <% if user.try(:pending_reconfirmation?) %>
                  <%= user.unconfirmed_email %>
                  <br>
                  <span class="label-text-alt">(<%= t('unconfirmed') %>)</span>
                <% else %>
                  <%= user.email %>
                <% end %>
              </td>
              <td>
                <span class="badge badge-info badge-outline whitespace-nowrap">
                  <%= t(user.role) %>
                </span>
                <%# A member who no longer holds a seat (D43): still here,
                    still able to read and download, simply cannot write. %>
                <% if user.read_only? %>
                  <span class="badge badge-ghost whitespace-nowrap ml-1"><%= t('read_only') %></span>
                <% end %>
              </td>
              <td>
                <%= user.current_sign_in_at ? l(user.current_sign_in_at.in_time_zone(current_account.timezone), format: :short, locale: current_account.locale) : '-' %>
              </td>
              <td class="flex items-center space-x-2 justify-end">
                <%= render 'users/row_actions', user: %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%# Seats that are held but not yet filled. They belong on this page
        because they are the other half of "who is in this account" — and on a
        paid account each one is already being billed for. %>
    <% if @pending_invites.present? %>
      <div class="mt-8">
        <h2 class="text-2xl font-bold mb-2"><%= t('pending_invitations') %></h2>
        <%# On a phone the table below scrolls sideways, and Resend/Cancel sat
            off the right edge of the screen with nothing to say they were
            there (checkpoint 7, B5). So on small screens each invitation is a
            card with its actions underneath it, and the table starts at md. %>
        <ul class="md:hidden space-y-3">
          <% @pending_invites.each do |invite| %>
            <% expires_on = l(invite.expires_at.in_time_zone(current_account.timezone).to_date, format: :long, locale: current_account.locale) %>
            <% parked = invite.payment_pending_until.present? %>
            <li class="rounded-2xl border border-base-300 bg-base-100 p-4" data-pending-invite-card="<%= invite.email %>">
              <p dir="auto" class="font-medium break-all"><%= invite.email %></p>
              <p class="mt-1 text-sm text-base-content/70">
                <% if parked %>
                  <%= invite.payment_pending? ? t('invite_awaiting_payment') : t('invite_payment_step_expired') %>
                <% else %>
                  <%= t('invite_pending_until', date: expires_on) %>
                <% end %>
              </p>
              <div class="mt-3 flex flex-wrap items-center gap-2">
                <span class="badge badge-info badge-outline whitespace-nowrap"><%= t(invite.role) %></span>
                <% unless parked %>
                  <%= button_to t('resend'), resend_account_invite_path(invite), method: :post, class: 'btn btn-outline btn-xs ms-auto' %>
                <% end %>
                <%= button_to t('cancel'), account_invite_path(invite), method: :delete, class: "btn btn-outline btn-error btn-xs#{' ms-auto' if parked}", form: { data: { turbo_confirm: t('are_you_sure_') } } %>
              </div>
            </li>
          <% end %>
        </ul>
        <div class="hidden md:block overflow-x-auto">
          <table class="table w-full table-lg rounded-b-none overflow-hidden">
            <thead class="bg-base-200">
              <tr class="text-neutral uppercase">
                <th><%= t('email') %></th>
                <th><%= t('role') %></th>
                <th><%= t('status') %></th>
                <th class="text-right" width="1px"></th>
              </tr>
            </thead>
            <tbody>
              <% @pending_invites.each do |invite| %>
                <% parked = invite.payment_pending_until.present? %>
                <tr scope="row" data-pending-invite="<%= invite.email %>">
                  <td dir="auto"><%= invite.email %></td>
                  <td>
                    <span class="badge badge-info badge-outline whitespace-nowrap"><%= t(invite.role) %></span>
                  </td>
                  <%# A parked purchase (checkpoint 7, P5) has no invitation
                      clock to show and nothing to send again: the card step it
                      is waiting for was never finished, so the only honest
                      status is "Awaiting payment" and the only action is
                      Cancel. Once Stripe's own deadline for that step has
                      passed the purchase can no longer be finished at all —
                      the hourly sweep settles the row, but until it runs the
                      status says so rather than pretending the clock is still
                      ticking (checkpoint 7, V2). %>
                  <td class="whitespace-nowrap">
                    <% if parked && invite.payment_pending? %>
                      <span class="badge badge-ghost whitespace-nowrap" data-invite-awaiting-payment="<%= invite.email %>"><%= t('invite_awaiting_payment') %></span>
                    <% elsif parked %>
                      <span class="badge badge-ghost whitespace-nowrap" data-invite-payment-expired="<%= invite.email %>"><%= t('invite_payment_step_expired') %></span>
                    <% else %>
                      <%= t('invite_pending_until', date: l(invite.expires_at.in_time_zone(current_account.timezone).to_date, format: :long, locale: current_account.locale)) %>
                    <% end %>
                  </td>
                  <td class="flex items-center space-x-2 justify-end">
                    <% unless parked %>
                      <%= button_to t('resend'), resend_account_invite_path(invite), method: :post, class: 'btn btn-outline btn-xs' %>
                    <% end %>
                    <%= button_to t('cancel'), account_invite_path(invite), method: :delete, class: 'btn btn-outline btn-error btn-xs', form: { data: { turbo_confirm: t('are_you_sure_') } } %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>
    <% if @pagy.pages > 1 %>
      <%= render 'shared/pagination', pagy: @pagy, items_name: 'users', left_additional_html: render('bottom_links') %>
    <% else %>
      <div class="mt-2">
        <%= render 'bottom_links' %>
      </div>
    <% end %>
  </div>
</div>
