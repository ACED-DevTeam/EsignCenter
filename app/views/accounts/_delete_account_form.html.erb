<%# Everything that is about to happen, then the two deliberate actions that
    make it happen: proving who you are, and ticking a box under the list. %>
<% purge_date = Accounts::Deletion.format_date(Accounts::Deletion.purge_date) %>
<% password_holder = true_user.encrypted_password.present? %>
<div class="space-y-4 pt-2" data-delete-account-modal>
  <p class="text-sm"><%= t('account_deletion_modal_intro', days: Accounts::Deletion::WINDOW_DAYS) %></p>
  <ul class="list-disc list-outside pl-5 space-y-1 text-sm">
    <li><%= t('account_deletion_bullet_subscription') %></li>
    <li><%= t('account_deletion_bullet_read_only') %></li>
    <li><%= t('account_deletion_bullet_permanent', date: purge_date) %></li>
    <li><%= t('account_deletion_bullet_cancel') %></li>
    <li><%= t('account_deletion_bullet_email') %></li>
    <li><%= t('account_deletion_bullet_verify') %></li>
  </ul>
  <div class="border rounded-xl p-3 space-y-1">
    <p class="font-semibold text-sm"><%= t('account_deletion_export_headline') %></p>
    <p class="text-sm"><%= t('account_deletion_export_hint', date: purge_date) %></p>
    <p class="text-sm">
      <%= link_to t('account_deletion_export_link'), templates_path, class: 'link font-semibold' %>
    </p>
  </div>
  <%= form_for '', url: settings_account_path, method: :delete, html: { autocomplete: 'off', class: 'space-y-4' } do |f| %>
    <% if password_holder %>
      <div class="form-control">
        <%= label_tag :password, t('account_deletion_password_label'), class: 'label' %>
        <%= password_field_tag :password, nil, required: true, autocomplete: 'current-password', class: 'base-input', data: { delete_account_password: true } %>
      </div>
    <% else %>
      <div class="form-control">
        <%= label_tag :account_name, t('account_deletion_account_name_label', name: current_account.name), class: 'label' %>
        <%= text_field_tag :account_name, nil, required: true, dir: 'auto', autocomplete: 'off', class: 'base-input', data: { delete_account_name: true } %>
        <span class="text-xs pt-1"><%= t('account_deletion_account_name_hint') %></span>
      </div>
    <% end %>
    <label class="flex items-start gap-2 cursor-pointer text-sm">
      <%= check_box_tag :confirm, '1', false, required: true, class: 'checkbox checkbox-sm mt-0.5', data: { delete_account_confirm: true } %>
      <span><%= t('account_deletion_confirm_label', date: purge_date) %></span>
    </label>
    <%= f.button button_title(title: t('account_deletion_submit_button'), disabled_with: t('submitting')), class: 'btn btn-error btn-block text-white' %>
  <% end %>
</div>
