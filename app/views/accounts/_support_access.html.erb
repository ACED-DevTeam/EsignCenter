<%# What the customer sees. Support looking inside an account is not something
    that should only be visible to support: every session is listed here, with
    the reason it was opened, for anybody who administers the account. The card
    is drawn only once there is something to show — an empty "nobody has ever
    looked at your account" panel is noise on a settings page. %>
<% sessions = can?(:administer, current_account) ? SupportImpersonation.recent_for(current_account) : [] %>
<% if sessions.any? %>
  <div class="px-1 mt-8" data-support-access-card>
    <h2 class="text-2xl font-bold mb-2"><%= t('support_access_title') %></h2>
    <p class="text-sm text-base-content/70 mb-3"><%= t('support_access_hint') %></p>
    <div class="overflow-x-auto">
      <table class="table w-full">
        <thead>
          <tr class="text-neutral uppercase">
            <th><%= t('support_access_when') %></th>
            <th><%= t('support_access_viewed_as') %></th>
            <th><%= t('support_access_mode') %></th>
            <th><%= t('support_access_duration') %></th>
            <th><%= t('support_access_reason') %></th>
          </tr>
        </thead>
        <tbody>
          <% sessions.each do |started, ended| %>
            <tr data-support-access-row="<%= started.id %>">
              <td class="whitespace-nowrap text-sm">
                <%= l(started.created_at.in_time_zone(current_account.timezone), format: :short) %>
              </td>
              <td dir="auto" class="break-all text-sm"><%= started.details['user_email'] %></td>
              <td class="text-sm"><%= SupportImpersonation.mode_label(started.details['mode']) %></td>
              <td class="whitespace-nowrap text-sm">
                <% seconds = ended&.details&.dig('duration_seconds') %>
                <% if seconds %>
                  <%= distance_of_time_in_words(seconds.to_i.seconds) %>
                <% else %>
                  <%= t('support_access_still_open') %>
                <% end %>
              </td>
              <td dir="auto" class="text-sm"><%= started.reason %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
