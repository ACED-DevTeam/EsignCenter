<%# A document being signed, drawn in SVG so it never needs a stock image. The signature stroke draws itself and the seal pops in (application.scss, .mk-hero-*), both only when the reader has not asked for reduced motion; without the animation the finished picture is what shows. %>
<div class="mk-hero-card relative w-full max-w-md" role="img" aria-label="A document with a signature being drawn, then sealed and timestamped">
  <svg viewBox="0 0 420 460" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto drop-shadow-2xl" aria-hidden="true" focusable="false">
    <rect x="46" y="26" width="330" height="410" rx="18" fill="#efeae6" />
    <rect x="24" y="44" width="330" height="410" rx="18" fill="#ffffff" stroke="#e7e2df" />
    <rect x="52" y="76" width="26" height="26" rx="7" fill="#4F46E5" />
    <path d="M58 89l7 7 13-14" stroke="#ffffff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none" />
    <rect x="90" y="80" width="140" height="10" rx="5" fill="#291334" opacity="0.8" />
    <rect x="90" y="96" width="90" height="7" rx="3.5" fill="#291334" opacity="0.3" />
    <rect x="52" y="140" width="270" height="8" rx="4" fill="#291334" opacity="0.14" />
    <rect x="52" y="160" width="240" height="8" rx="4" fill="#291334" opacity="0.14" />
    <rect x="52" y="180" width="256" height="8" rx="4" fill="#291334" opacity="0.14" />
    <rect x="52" y="200" width="180" height="8" rx="4" fill="#291334" opacity="0.14" />
    <rect x="52" y="236" width="270" height="8" rx="4" fill="#291334" opacity="0.14" />
    <rect x="52" y="256" width="210" height="8" rx="4" fill="#291334" opacity="0.14" />
    <rect x="52" y="304" width="240" height="84" rx="12" fill="#eef2ff" stroke="#c7d2fe" />
    <rect x="64" y="314" width="58" height="7" rx="3.5" fill="#4F46E5" opacity="0.6" />
    <path class="mk-hero-sign" d="M72 366c10-26 20-38 24-30 3 8-8 30-2 30 8 0 14-34 22-34 6 0 2 28 10 28 10 0 14-30 24-30 8 0 4 26 12 26 12 0 18-34 30-34 8 0 6 30 16 30 12 0 20-26 30-26 6 0 8 10 22 4" stroke="#4F46E5" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" fill="none" />
    <line x1="64" y1="372" x2="280" y2="372" stroke="#c7d2fe" stroke-width="1.5" />
    <g class="mk-hero-seal">
      <circle cx="322" cy="386" r="46" fill="#4F46E5" />
      <circle cx="322" cy="386" r="38" fill="none" stroke="#ffffff" stroke-opacity="0.5" stroke-width="2" stroke-dasharray="4 5" />
      <path d="M302 387l13 13 27-30" stroke="#ffffff" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" fill="none" />
    </g>
  </svg>
  <div class="absolute left-4 sm:left-0 -bottom-4 sm:-bottom-6 bg-white rounded-xl shadow-lg border border-base-content/10 px-4 py-3 flex items-center gap-3 text-sm" aria-hidden="true">
    <span class="inline-flex w-8 h-8 rounded-full bg-emerald-100 text-emerald-700 items-center justify-center">
      <%= svg_icon('check', class: 'w-5 h-5 stroke-2') %>
    </span>
    <span><span class="font-semibold">Sealed and timestamped</span><br><span class="text-base-content/70">Audit trail attached</span></span>
  </div>
</div>
