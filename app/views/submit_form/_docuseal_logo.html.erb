<% if (logo_url = account_logo_url(@submitter&.account)) %>
  <a href="<%= root_path %>" class="mx-auto flex justify-center items-center">
    <%= image_tag logo_url,
                  alt: @submitter.account.name,
                  class: 'object-contain',
                  style: 'max-height: 48px; max-width: 240px;' %>
  </a>
<% end %>
<%# No engine logo/name when the account has no logo of its own — the signing
    view is embedded inside the host product, whose chrome already brands the
    page. The AGPL 7(b) "Powered by DocuSeal" attribution is rendered by the
    shared footer partial and is intentionally kept. %>
