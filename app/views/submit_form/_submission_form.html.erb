<% data_attachments = attachments_index.values.select { |e| e.record_id == submitter.id }.to_json(only: %i[uuid created_at], methods: %i[url filename content_type]) %>
<% data_fields = Submissions.filtered_conditions_fields(submitter).to_json %>
<% invite_submitters = (submitter.submission.template_submitters || submitter.submission.template.submitters).select { |s| s['invite_by_uuid'] == submitter.uuid && submitter.submission.submitters.none? { |e| e.uuid == s['uuid'] } }.to_json %>
<% optional_invite_submitters = (submitter.submission.template_submitters || submitter.submission.template.submitters).select { |s| s['optional_invite_by_uuid'] == submitter.uuid && submitter.submission.submitters.none? { |e| e.uuid == s['uuid'] } }.to_json %>
<%# The dry-run preview's signer record is never saved, so its "View this document as a PDF" link answers off the template instead of the signer's slug. %>
<%# Over the merge cap the link serves the first document only, so it says so rather than promising the whole thing (Submissions::OriginalDocumentPdf). %>
<% esign_consent_documents = Submissions::OriginalDocumentPdf.form_attachments(submitter, dry_run: local_assigns[:dry_run].present?) %>
<% esign_consent_view_pdf_key = Submissions::OriginalDocumentPdf.truncated?(esign_consent_documents) ? 'esign_consent_view_first_pdf' : 'esign_consent_view_pdf' %>
<%# No documents to serve means the door can only 404, so no link is offered at all: the checkbox gate is `!!config.pdf_url && !pdfOpened`, and with no url it opens by itself rather than locking the signer behind a link that cannot work. %>
<% esign_consent_pdf_url = esign_consent_documents.presence && (local_assigns[:dry_run] ? (submitter.submission.template && template_form_document_path(submitter.submission.template, format: :pdf)) : submit_form_document_path(submitter.slug, format: :pdf)) %>
<%# The language this page really rendered the disclosure in, with the server's own signature over it: the completion request's locale is client-controlled (?lang=, Accept-Language), so the token — not the request — is what the consent record is bound to (EsignConsent.record!). %>
<% esign_consent_locale = EsignConsent.rendered_locale %>
<% esign_consent = { version: EsignConsent::VERSION, locale: esign_consent_locale, locale_token: EsignConsent.locale_token(submitter, esign_consent_locale), consented: EsignConsent.consented?(submitter), label: t('esign_consent_checkbox_label'), link_text: t('esign_consent_disclosure_link'), required_message: t('esign_consent_required'), stale_message: t('esign_consent_version_stale'), modal_id: 'esign_disclosure_modal', pdf_url: esign_consent_pdf_url, view_pdf_text: t(esign_consent_view_pdf_key), open_pdf_first: t('esign_consent_open_pdf_first'), sender_digest: EsignConsent.sender_digest(submitter) }.to_json %>
<submission-form data-esign-consent="<%= esign_consent %>" data-is-demo="<%= Docuseal.demo? %>" data-schema="<%= schema.to_json %>" data-reuse-signature="<%= configs[:reuse_signature] %>" data-require-signing-reason="<%= configs[:require_signing_reason] %>" data-with-signature-id="<%= configs[:with_signature_id] %>" data-with-field-labels="<%= configs[:with_field_labels] %>" data-with-confetti="<%= configs[:with_confetti] %>" data-completed-redirect-url="<%= submitter.preferences['completed_redirect_url'].presence || submitter.submission.template&.preferences&.dig('completed_redirect_url') %>" data-completed-message="<%= (configs[:completed_message]&.compact_blank.presence || submitter.submission.template&.preferences&.dig('completed_message') || {}).to_json %>" data-completed-button="<%= configs[:completed_button].to_json %>" data-go-to-last="<%= submitter.preferences.key?('go_to_last') ? submitter.preferences['go_to_last'] : submitter.opened_at? %>" data-submitter="<%= submitter.to_json(only: %i[id uuid slug name phone email submission_id completed_at]) %>" data-can-send-email="<%= Accounts.can_send_emails?(submitter.submission.account) %>" data-optional-invite-submitters="<%= optional_invite_submitters %>" data-invite-submitters="<%= invite_submitters %>" data-attachments="<%= data_attachments %>" data-fields="<%= data_fields %>" data-values="<%= submitter.values.to_json %>" data-with-typed-signature="<%= configs[:with_typed_signature] %>" data-signature-text="<%= params[:signature] %>" data-previous-signature-value="<%= local_assigns[:signature_attachment]&.uuid %>" data-remember-signature="<%= configs[:prefill_signature] %>" data-dry-run="<%= local_assigns[:dry_run] %>" data-expand="<%= local_assigns[:expand] %>" data-scroll-padding="<%= local_assigns[:scroll_padding] %>" data-language="<%= I18n.locale.to_s.split('-').first %>" data-embed-origin="<%= submitter.submission.source_embed? ? submitter.submission.preferences['embed_origin'] : nil %>" data-embed-origins="<%= submitter.submission.source_embed? ? (Array(submitter.submission.preferences['embed_origins']).presence || Array(submitter.submission.preferences['embed_origin'])).compact_blank.join(',') : nil %>"></submission-form>
