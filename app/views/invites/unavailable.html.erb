  <div class="text-center space-y-3">
    <div class="mx-auto w-16 h-16 rounded-full bg-base-200 flex items-center justify-center">
      <%= svg_icon('info_circle', class: 'w-9 h-9') %>
    </div>
    <h1 dir="auto" class="text-3xl md:text-4xl font-bold"><%= t('invite_unavailable_title') %></h1>
    <p dir="auto" class="text-base-content/80 leading-relaxed"><%= t('invite_unavailable_hint') %></p>
  </div>
</main>
