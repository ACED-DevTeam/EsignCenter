<%# The public face of the product (Session 9): the landing, pricing, trust and legal pages share this layout. These pages are English-only by decision — the controllers force I18n to :en (ApplicationController#with_english) so an account whose locale is French never sees a French-labelled English page, and the legal texts stay the exact bytes acceptance rows are hashed against. The translated pricing-row keys in i18n.yml are therefore unused on the web today and harmless. %>
<!DOCTYPE html>
<html data-theme="docuseal" lang="en">
  <head>
    <%= render 'layouts/head_tags' %>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%= csrf_meta_tags %>
    <%= javascript_pack_tag 'application', defer: true %>
    <% if canonical_url = content_for(:canonical_url) %>
      <link href="<%= canonical_url %>" rel="canonical">
    <% end %>
    <%= stylesheet_pack_tag 'application', media: 'all' %>
  </head>
  <body class="bg-base-100 text-base-content antialiased">
    <%# Every link in the header and footer is required by the positioning brief; "Start free" exists only while self-serve registration is switched on, because /sign_up is a 404 otherwise. Without JavaScript the phone menu button does nothing, and the footer carries every link the menu holds. %>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:px-4 focus:py-2 focus:bg-base-100 focus:rounded-lg focus:shadow-lg focus:font-medium"><%= t('skip_to_content') %></a>
    <%= render 'shared/support_impersonation_banner' %>
    <% start_path = Docuseal.registration_enabled? ? new_registration_path : new_user_session_path %>
    <header class="sticky top-0 z-30 bg-base-100/90 backdrop-blur border-b border-base-content/5">
      <marketing-menu class="block relative max-w-6xl mx-auto px-4 md:px-2">
        <div class="h-16 flex items-center justify-between gap-4">
          <a href="<%= root_path %>" class="flex items-center gap-2.5 text-xl font-bold tracking-tight rounded-md" aria-label="<%= Docuseal.product_name %> home">
            <%= render 'shared/logo', width: '32', height: '32', class: 'flex-none' %>
            <span><%= Docuseal.product_name %></span>
          </a>
          <button type="button" data-toggle class="md:hidden inline-flex items-center justify-center w-11 h-11 -mr-2 rounded-lg hover:bg-base-200" aria-expanded="false" aria-controls="marketing-nav" aria-label="Menu">
            <span data-icon-closed aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 12h16M4 18h16"></path></svg>
            </span>
            <span data-icon-open class="hidden" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18M6 6l12 12"></path></svg>
            </span>
          </button>
          <nav id="marketing-nav" data-panel aria-label="Main" class="mk-menu-panel absolute md:static inset-x-0 top-full md:top-auto flex-col md:flex-row md:items-center gap-1 md:gap-2 p-3 md:p-0 bg-base-100 md:bg-transparent border-b md:border-0 border-base-content/10 shadow-xl md:shadow-none text-base font-medium">
            <%= link_to 'Pricing', pricing_path, class: 'px-3 py-2.5 rounded-lg hover:bg-base-200 md:hover:bg-transparent md:hover:text-indigo-700' %>
            <%= link_to 'Help', help_path, class: 'px-3 py-2.5 rounded-lg hover:bg-base-200 md:hover:bg-transparent md:hover:text-indigo-700' %>
            <% if signed_in? %>
              <%= link_to 'Dashboard', root_path, class: 'btn btn-neutral btn-sm text-white md:ml-2 mt-1 md:mt-0' %>
            <% else %>
              <%= link_to t('sign_in'), new_user_session_path, class: 'px-3 py-2.5 rounded-lg hover:bg-base-200 md:hover:bg-transparent md:hover:text-indigo-700' %>
              <% if Docuseal.registration_enabled? %>
                <%# A full page load on purpose: the sign-up page carries its own security policy (the Turnstile widget's host), which a Turbo visit would not apply. %>
                <%= link_to 'Start free', start_path, class: 'btn btn-neutral btn-sm text-white md:ml-2 mt-1 md:mt-0', data: { turbo: false } %>
              <% end %>
            <% end %>
          </nav>
        </div>
      </marketing-menu>
    </header>
    <%# The flash is `absolute top-0` with no positioned ancestor of its own, so
        left alone it pins itself to the top of the viewport and disappears
        under this layout's sticky z-30 header — "Signed out successfully." was
        being drawn behind the wordmark. This wrapper gives it something to be
        absolute inside (directly under the header) and a stacking order above
        it. Zero height, so it overlays the page rather than pushing it down,
        exactly as it does in the app layout. %>
    <% if flash.present? %>
      <div class="relative z-40 h-0"><%= render 'shared/flash' %></div>
    <% end %>
    <main id="main" tabindex="-1">
      <%= yield %>
    </main>
    <footer class="mt-24 border-t border-base-content/10 bg-base-200/50">
      <div class="max-w-6xl mx-auto px-4 md:px-2 py-12 grid gap-10 md:grid-cols-12 text-sm">
        <div class="md:col-span-5 space-y-3">
          <a href="<%= root_path %>" class="inline-flex items-center gap-2.5 text-lg font-bold tracking-tight rounded-md">
            <%= render 'shared/logo', width: '28', height: '28', class: 'flex-none' %>
            <span><%= Docuseal.product_name %></span>
          </a>
          <p class="text-base-content/70 max-w-xs">Send it. Get it signed. Prove it. Document signing for freelancers, small businesses and everyday agreements.</p>
          <p class="text-base-content/70">Questions or a security report: <%= link_to 'contact support', support_path, class: 'link link-hover font-medium' %>, or email <%= mail_to Docuseal::SUPPORT_EMAIL, Docuseal::SUPPORT_EMAIL, class: 'link link-hover font-medium' %>.</p>
        </div>
        <nav aria-label="Product" class="md:col-span-2 space-y-2">
          <h2 class="font-semibold text-base-content">Product</h2>
          <ul class="space-y-2 text-base-content/70">
            <li><%= link_to 'Pricing', pricing_path, class: 'link link-hover' %></li>
            <li><%= link_to 'Verify a document', verify_path, class: 'link link-hover' %></li>
            <li><%= link_to 'Help centre', help_path, class: 'link link-hover' %></li>
            <li><%= link_to 'Contact support', support_path, class: 'link link-hover' %></li>
            <li><%= link_to 'API reference', api_reference_path, class: 'link link-hover' %></li>
            <% if signed_in? %>
              <li><%= link_to 'Dashboard', root_path, class: 'link link-hover' %></li>
            <% else %>
              <li><%= link_to t('sign_in'), new_user_session_path, class: 'link link-hover' %></li>
              <% if Docuseal.registration_enabled? %>
                <li><%= link_to 'Start free', start_path, class: 'link link-hover', data: { turbo: false } %></li>
              <% end %>
            <% end %>
          </ul>
        </nav>
        <nav aria-label="Legal" class="md:col-span-2 space-y-2">
          <h2 class="font-semibold text-base-content">Legal</h2>
          <ul class="space-y-2 text-base-content/70">
            <li><%= link_to 'Terms', terms_path, class: 'link link-hover' %></li>
            <li><%= link_to 'Privacy', privacy_path, class: 'link link-hover' %></li>
            <li><%= link_to 'Trust', trust_path, class: 'link link-hover' %></li>
            <li><%= link_to 'Sub-processors', subprocessors_path, class: 'link link-hover' %></li>
          </ul>
        </nav>
        <nav aria-label="Source" class="md:col-span-3 space-y-2">
          <h2 class="font-semibold text-base-content">Open source</h2>
          <ul class="space-y-2 text-base-content/70">
            <li><a href="<%= Docuseal::GITHUB_URL %>" target="_blank" rel="noopener" class="link link-hover">Source code on GitHub</a></li>
            <li>Licensed under the AGPL. Built on DocuSeal.</li>
          </ul>
        </nav>
      </div>
      <div class="border-t border-base-content/10">
        <div class="max-w-6xl mx-auto px-4 md:px-2 py-6 flex flex-col md:flex-row md:items-center md:justify-between gap-3 text-sm text-base-content/70">
          <p>&copy; <%= Time.current.year %> <%= Docuseal.product_name %>. Hosted in the United States.</p>
          <%# AGPL LICENSE_ADDITIONAL_TERMS: the DocuSeal attribution below must stay visible on every page. %>
          <%= render 'shared/attribution' %>
        </div>
      </div>
    </footer>
    <%= render 'shared/body_scripts' %>
  </body>
</html>
