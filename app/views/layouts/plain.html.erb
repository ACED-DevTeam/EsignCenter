<!DOCTYPE html>
<html data-theme="docuseal" lang="<%= I18n.locale %>">
  <head>
    <%= render 'layouts/head_tags' %>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%= csrf_meta_tags %>
    <%= javascript_pack_tag 'application', defer: true %>
    <%= stylesheet_pack_tag 'application', media: 'all' %>
  </head>
  <body>
    <%= render 'shared/support_impersonation_banner' %>
    <% if flash.present? %><%= render 'shared/flash' %><% end %>
    <%= yield %>
    <%# AGPL LICENSE_ADDITIONAL_TERMS: the DocuSeal attribution and the source
        link (AGPL section 13) must reach every user. The embedded builder
        draws its own footer, so the layout only adds one when the page has
        not. %>
    <% unless content_for?(:attribution_rendered) %>
      <footer class="py-3 text-xs text-base-content/70">
        <%= render 'shared/attribution', account: current_account || @submission&.account || @template&.account %>
      </footer>
    <% end %>
    <turbo-frame id="modal"></turbo-frame>
  </body>
</html>
