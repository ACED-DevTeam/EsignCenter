<!DOCTYPE html>
<html data-theme="docuseal" lang="<%= I18n.locale %>">
  <head>
    <%= render 'layouts/head_tags' %>
    <% if Docuseal.enable_pwa? %>
      <link rel="manifest" href="/manifest.json">
    <% end %>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%= csrf_meta_tags %>
    <%= javascript_pack_tag 'application', defer: true %>
    <% if canonical_url = content_for(:canonical_url) %>
      <link href="<%= canonical_url %>" rel="canonical">
    <% end %>
    <%= stylesheet_pack_tag 'application', media: 'all' %>
  </head>
  <body>
    <%= render 'shared/support_impersonation_banner' %>
    <% if params[:modal].present? %>
      <% modal_uri = Addressable::URI.parse(params[:modal]) %>
      <% url_params = Rails.application.routes.recognize_path(modal_uri.path, method: :get) %>
      <% if url_params[:action] == 'new' %>
        <open-modal src="<%= url_for(**url_params, params: modal_uri.query_values) %>"></open-modal>
      <% end %>
    <% end %>
    <turbo-frame id="modal"></turbo-frame>
    <turbo-frame id="drawer"></turbo-frame>
    <%= render 'shared/navbar' %>
    <% if flash.present? %><%= render 'shared/flash' %><% end %>
    <%= render 'shared/autosave_toasts' %>
    <div class="max-w-6xl mx-auto px-4 md:px-2 mb-8">
      <%= yield %>
    </div>
    <%# AGPL LICENSE_ADDITIONAL_TERMS: the DocuSeal attribution and the source
        link (AGPL section 13) must reach every user, signed in or not. %>
    <% unless content_for?(:attribution_rendered) %>
      <footer class="max-w-6xl mx-auto px-4 md:px-2 pb-6 text-xs text-base-content/60">
        <%= render 'shared/attribution', account: attribution_account %>
      </footer>
    <% end %>
    <%= render 'shared/body_scripts' %>
  </body>
</html>
