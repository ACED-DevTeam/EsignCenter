<!DOCTYPE html>
<html data-theme="docuseal" lang="<%= I18n.locale %>">
  <head>
    <%= render 'layouts/head_tags' %>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%= csrf_meta_tags %>
    <%= javascript_pack_tag 'form', defer: true %>
    <%= stylesheet_pack_tag 'form', media: 'all' %>
  </head>
  <body>
    <%# A signed-in page can render with this layout too (the template preview),
        so the support-session bar belongs here as well. %>
    <%= render 'shared/support_impersonation_banner' %>
    <%= yield %>
    <%# AGPL LICENSE_ADDITIONAL_TERMS: the DocuSeal attribution and the source
        link (AGPL section 13) must reach every user. Signing pages draw their
        own footer and mark it, and the layout then skips this one; the rest
        (an invitation, a document report) get it here. %>
    <% unless content_for?(:attribution_rendered) %>
      <footer class="py-3 text-xs text-base-content/70">
        <%= render 'shared/attribution', account: attribution_account %>
      </footer>
    <% end %>
  </body>
</html>
