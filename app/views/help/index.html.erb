<% content_for(:html_title, 'Help centre — EsignCenter') %>
<% content_for(:html_description, 'How to send a document, what a signer sees, what the free plan includes, and how to check a signed PDF. Ten short articles, no account needed.') %>
<% content_for(:canonical_url, help_url) %>
<% content_for(:indexable, 'true') %>
<%# The table of contents comes from HelpCenter (lib/help_center.rb), which reads app/views/help/articles/REGISTRY.yml — the same file the writer edits. Sections and their articles are in registry order. %>

<section class="mk-ground">
  <div class="max-w-6xl mx-auto px-4 md:px-2 pt-14 pb-10 md:pt-20 md:pb-14 text-center">
    <h1 class="text-4xl md:text-5xl font-bold tracking-tight">Help centre</h1>
    <p class="mt-4 text-lg md:text-xl text-base-content/70 max-w-2xl mx-auto">Short answers about sending, signing, plans and your data. No account needed to read any of them.</p>
    <p class="mt-6 text-base-content/70">Cannot find it? <%= link_to 'Ask us directly', support_path, class: 'link font-medium' %> — a real person replies, usually within one business day.</p>
  </div>
</section>

<div class="max-w-6xl mx-auto px-4 md:px-2 pb-4 md:pb-8">
  <% @sections.each do |section, articles| %>
    <section class="pt-10 md:pt-14" aria-labelledby="section-<%= section.parameterize %>">
      <h2 id="section-<%= section.parameterize %>" class="text-2xl md:text-3xl font-bold tracking-tight"><%= section %></h2>
      <ul class="mt-6 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        <% articles.each do |article| %>
          <li class="h-full">
            <%= link_to help_article_path(article.slug), class: 'group h-full flex flex-col rounded-2xl bg-white border border-base-content/10 p-6 shadow-sm hover:shadow-md hover:border-indigo-300 transition' do %>
              <h3 class="text-lg font-semibold tracking-tight group-hover:text-indigo-700"><%= article.title %></h3>
              <p class="mt-2 text-base-content/70 flex-1"><%= article.summary %></p>
              <span class="mt-4 text-sm font-medium text-indigo-700 inline-flex items-center gap-1">
                Read it
                <span aria-hidden="true">&rarr;</span>
              </span>
            <% end %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
</div>

<section class="max-w-6xl mx-auto px-4 md:px-2 py-14 md:py-20">
  <div class="rounded-3xl bg-neutral text-white p-8 md:p-12 text-center">
    <h2 class="text-2xl md:text-3xl font-bold tracking-tight">Still stuck?</h2>
    <p class="mt-3 text-white/75 max-w-xl mx-auto">Tell us what you were trying to do and what happened instead. We reply to every message, usually within one business day.</p>
    <div class="mt-7 flex flex-col sm:flex-row gap-3 justify-center">
      <%= link_to 'Contact support', support_path, class: 'btn bg-white text-neutral hover:bg-indigo-50 border-0 text-base px-8' %>
      <%= link_to 'API reference', api_reference_path, class: 'btn btn-outline text-white border-white/40 hover:bg-white/10 hover:border-white text-base px-8' %>
    </div>
  </div>
</section>
