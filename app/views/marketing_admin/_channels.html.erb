<% wait = social[:refresh_available_in] %>
<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
  <p class="text-sm text-base-content/70" data-channels-hint>
    <% if !social[:any_api_connected] %>
      None of the apps are connected yet. Each card says what it is waiting for.
    <% elsif social[:last_check_at] %>
      Last checked <%= mka_time(social[:last_check_at]) %>.
    <% else %>
      Connected. The first numbers arrive with the next morning check, or press Refresh now.
    <% end %>
  </p>
  <% if social[:any_api_connected] %>
    <div class="flex items-center gap-3">
      <% if wait.positive? %>
        <span class="text-sm text-base-content/70">Checked a few minutes ago. Ready again in <%= (wait / 60.0).ceil %> min.</span>
      <% end %>
      <%= button_to 'Refresh now', marketing_admin_refresh_path, method: :post, class: 'btn btn-sm btn-outline bg-white whitespace-nowrap', disabled: wait.positive?, data: { turbo: false } %>
    </div>
  <% end %>
</div>
<div class="grid gap-4 sm:grid-cols-2" aria-label="Followers on each app">
  <% social[:cards].each do |card| %>
    <%= render 'channel', card: %>
  <% end %>
</div>
<div class="bg-white rounded-2xl border border-base-content/10 p-5 sm:p-6" data-card="top-posts">
  <h3 class="font-semibold">Top posts</h3>
  <% if social[:top_posts].empty? %>
    <p class="mt-2 text-sm text-base-content/70" data-empty="posts">
      <%= social[:cards].any? { |card| card[:state] == :ok && !card[:manual] } ? 'No posts yet. Once something is posted, the most-viewed ones show up here.' : 'The most-viewed posts show up here once YouTube, Facebook or Instagram is connected.' %>
    </p>
  <% else %>
    <p class="mt-1 text-sm text-base-content/70">Most-viewed across the connected apps, from the latest check.</p>
    <ol class="mt-3 divide-y divide-base-content/10">
      <% social[:top_posts].each do |post| %>
        <li class="py-3 flex flex-col sm:flex-row sm:items-start sm:justify-between gap-1 sm:gap-4">
          <div class="min-w-0">
            <% if post[:url].to_s.start_with?('https://') %>
              <a href="<%= post[:url] %>" target="_blank" rel="noopener" class="font-medium hover:underline hover:text-indigo-700 break-words"><%= post[:title].presence || 'Untitled post' %></a>
            <% else %>
              <span class="font-medium break-words"><%= post[:title].presence || 'Untitled post' %></span>
            <% end %>
            <p class="text-sm text-base-content/70">
              <%= post[:platform] %><% if (published = (Time.zone.parse(post[:published_at].to_s) rescue nil)) %>, posted <%= mka_day(published.in_time_zone(MarketingAdmin::TIME_ZONE)) %><% end %>
            </p>
          </div>
          <div class="flex-none flex gap-3 items-baseline sm:block sm:text-right">
            <p class="font-semibold"><%= mka_number(post[:views]) %> <span class="font-normal text-sm text-base-content/70"><%= post[:views] == 1 ? 'view' : 'views' %></span></p>
            <p class="text-sm text-base-content/70"><%= mka_number(post[:likes]) %> <%= post[:likes] == 1 ? 'like' : 'likes' %>, <%= mka_number(post[:comments]) %> <%= post[:comments] == 1 ? 'comment' : 'comments' %></p>
          </div>
        </li>
      <% end %>
    </ol>
    <% if social[:top_posts].any? { |post| post[:views].nil? || post[:likes].nil? || post[:comments].nil? } %>
      <p class="mt-2 text-xs text-base-content/70">A dash means the app doesn’t share that number.</p>
    <% end %>
  <% end %>
</div>
