<% content_for(:html_title, "Marketing — #{Docuseal.product_name}") %>
<%# The private marketing page (docs/marketing-admin.md). Each section is built on its own in the controller; one that could not be read is nil here and says so in its own place. %>
<div class="mka-figures pb-10" data-marketing-admin>
  <header class="pt-2 md:pt-6 pb-6 flex flex-col md:flex-row md:items-end md:justify-between gap-4">
    <div>
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight">Marketing</h1>
      <p class="mt-3 text-lg text-base-content/70 max-w-2xl">How the website, sign-ups, social channels and outreach are doing.</p>
    </div>
    <p class="text-sm text-base-content/70 md:text-right">
      <span class="block font-medium text-base-content"><%= @today.strftime('%A, %B %-d') %></span>
      Days run midnight to midnight, Central time.
    </p>
  </header>
  <nav aria-label="Sections" class="flex gap-1 overflow-x-auto -mx-4 px-4 md:mx-0 md:px-0 border-b border-base-content/10 text-base font-medium">
    <% [%w[Website website], %w[Product product], %w[Channels channels], %w[Outreach outreach]].each do |label, anchor| %>
      <a href="#<%= anchor %>" class="px-2.5 sm:px-3 py-2.5 -mb-px border-b-2 border-transparent hover:border-indigo-600 hover:text-indigo-700 whitespace-nowrap"><%= label %></a>
    <% end %>
  </nav>
  <%= render 'section', id: 'website', title: 'Website', lede: 'Page views on the public pages: the home page, pricing, trust, help, support, the API reference and the legal pages.', loaded: @traffic.present? do %>
    <%= render 'website', traffic: @traffic %>
  <% end %>
  <%= render 'section', id: 'product', title: 'Product', lede: 'What the marketing is for: new accounts, paid plans, and documents sent and completed.', loaded: @product.present? do %>
    <%= render 'product', product: @product %>
  <% end %>
  <%= render 'section', id: 'channels', title: 'Channels', lede: 'Followers, views and posts on each social app, checked every morning around 5 am Central.', loaded: @social.present? do %>
    <%= render 'channels', social: @social %>
  <% end %>
  <%= render 'section', id: 'outreach', title: 'Outreach', lede: 'What the outreach jobs did each day: emails, replies, and comments on Reddit and in Facebook groups.', loaded: @outreach.present? do %>
    <%= render 'outreach', outreach: @outreach %>
  <% end %>
  <p class="mt-12 pt-6 border-t border-base-content/10 text-sm text-base-content/70 max-w-3xl">
    Only people on the marketing list can open this page. Website numbers are page views counted on our own server, with no cookies and no record of who visited. Social numbers come from each app. Outreach numbers are reported by the Mac jobs.
  </p>
</div>
