<% if !outreach[:any] %>
  <div class="bg-white rounded-2xl border border-base-content/10 p-5 sm:p-6" data-empty="outreach">
    <p class="text-xl font-semibold">Nothing reported yet</p>
    <p class="mt-1 text-base-content/70 max-w-2xl">
      <% if MarketingAdmin::Outreach.configured? %>
        The outreach jobs on the Mac send each day’s totals here. The first report fills this section in.
      <% else %>
        Not connected yet. The outreach jobs on the Mac report here once their shared token is set on the server.
      <% end %>
    </p>
  </div>
<% else %>
  <dl class="grid grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-6">
    <% outreach[:kinds].each do |kind| %>
      <div data-outreach-kind="<%= kind[:key] %>">
        <dt class="text-sm font-medium text-base-content/70"><%= kind[:label] %></dt>
        <dd class="mt-1 text-4xl font-bold tracking-tight"><%= mka_number(kind[:last7]) %></dd>
        <dd class="mt-1 text-sm text-base-content/70">in 7 days, <%= mka_number(kind[:previous7]) %> the week before</dd>
      </div>
    <% end %>
  </dl>
  <div class="bg-white rounded-2xl border border-base-content/10 p-5 sm:p-6" data-card="outreach-days">
    <h3 class="font-semibold">Day by day</h3>
    <div class="mt-3 overflow-x-auto">
      <table class="w-full text-sm text-left">
        <thead class="text-base-content/70">
          <tr>
            <th class="py-1.5 pr-4 font-medium">Day</th>
            <% outreach[:kinds].each do |kind| %>
              <th class="py-1.5 pl-2 sm:pl-4 font-medium text-right whitespace-nowrap"><span class="sm:hidden"><%= kind[:short] %></span><span class="hidden sm:inline"><%= kind[:label] %></span></th>
            <% end %>
          </tr>
        </thead>
        <tbody class="divide-y divide-base-content/10">
          <% outreach[:days].each do |row| %>
            <tr class="<%= 'text-base-content/60' unless row[:reported] %>">
              <td class="py-2 pr-2 sm:pr-4 whitespace-nowrap"><%= row[:day] == @today ? 'Today' : mka_weekday(row[:day]) %></td>
              <% outreach[:kinds].each do |kind| %>
                <td class="py-2 pl-2 sm:pl-4 text-right <%= 'font-semibold' if row[:counts][kind[:key]].to_i.positive? %>"><%= mka_number(row[:counts][kind[:key]]) %></td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <p class="mt-3 text-xs text-base-content/70">
      A dash means nothing was reported for that day.
      <% if outreach[:last_reported_at] %>Last report <%= mka_time(outreach[:last_reported_at]) %>.<% end %>
    </p>
  </div>
<% end %>
