<% series = traffic[:daily].map { |d| { day: d[:day], value: d[:views], counted: d[:counted] } } %>
<% trend, direction = mka_trend(traffic[:last7], traffic[:previous7]) %>
<% range_names = { 1 => 'Today', 7 => 'Last 7 days', 30 => 'Last 30 days' } %>
<dl class="grid sm:grid-cols-3 divide-y sm:divide-y-0 sm:divide-x divide-base-content/10">
  <%= render 'figure', label: 'Page views today', value: mka_number(traffic[:today]), note: 'So far today' %>
  <%= render 'figure', label: 'Last 7 days', value: mka_number(traffic[:last7]), note: (trend if traffic[:first_day] && traffic[:first_day] <= @today - 13), direction: %>
  <%= render 'figure', label: 'Last 30 days', value: mka_number(traffic[:last30]), note: 'Including today' %>
</dl>
<div class="bg-white rounded-2xl border border-base-content/10 p-5 sm:p-6" data-card="daily-views">
  <h3 class="font-semibold">Page views per day</h3>
  <% if traffic[:first_day].nil? %>
    <p class="mt-2 text-base-content/70" data-empty="views">Nothing counted yet. Counting starts with the first visit to a public page, and the chart fills in from there.</p>
  <% else %>
    <div class="mt-4">
      <%= render 'columns', days: series, noun: 'page view', tall: true, today: @today %>
    </div>
    <% if traffic[:first_day] > series.first[:day] %>
      <p class="mt-1 text-sm text-base-content/70" data-history-starts>History starts <%= mka_day(traffic[:first_day]) %>. Earlier days are blank because nothing was being counted, not because nobody came.</p>
    <% end %>
    <details class="mt-3 text-sm">
      <summary class="cursor-pointer font-medium text-indigo-700 hover:underline w-fit">Show as a table</summary>
      <div class="mt-3 overflow-x-auto">
        <table class="w-full text-left">
          <thead class="text-base-content/70">
            <tr><th class="py-1.5 pr-4 font-medium">Day</th><th class="py-1.5 pr-4 font-medium text-right">Page views</th><th class="py-1.5 font-medium text-right">Sign-up page opened</th></tr>
          </thead>
          <tbody class="divide-y divide-base-content/10">
            <% traffic[:daily].reverse_each do |d| %>
              <tr>
                <td class="py-1.5 pr-4 whitespace-nowrap"><%= mka_weekday(d[:day]) %></td>
                <td class="py-1.5 pr-4 text-right"><%= d[:counted] ? mka_number(d[:views]) : '—' %></td>
                <td class="py-1.5 text-right"><%= d[:counted] ? mka_number(d[:signup_opens]) : '—' %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </details>
  <% end %>
</div>
<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pt-2">
  <h3 class="text-lg font-semibold" id="website-breakdown">Where the views went and came from</h3>
  <div class="inline-flex rounded-full border border-base-content/20 bg-white p-1 text-sm font-medium w-fit" role="group" aria-label="Period for the breakdowns below">
    <% range_names.each do |days, name| %>
      <%= link_to name, marketing_admin_path(range: days, anchor: 'website-breakdown'), class: "px-3 py-1.5 rounded-full whitespace-nowrap #{traffic[:range] == days ? 'bg-neutral text-white' : 'hover:bg-base-200'}", aria: { current: (traffic[:range] == days ? 'true' : nil) } %>
    <% end %>
  </div>
</div>
<% if traffic[:view_total].zero? %>
  <div class="bg-white rounded-2xl border border-base-content/10 p-5 sm:p-6" data-card="breakdowns" data-empty="breakdowns">
    <p class="text-base-content/70">No page views <%= traffic[:range] == 1 ? 'today yet' : "in the #{range_names[traffic[:range]].downcase}" %>. Pages, where visits came from and devices are listed here once there are some.</p>
  </div>
<% else %>
  <div class="bg-white rounded-2xl border border-base-content/10 p-5 sm:p-6 grid gap-8 md:grid-cols-3" data-card="breakdowns">
    <%= render 'rank', title: 'Pages', rows: traffic[:pages] %>
    <%= render 'rank', title: 'Where visits came from', rows: traffic[:sources] %>
    <%= render 'rank', title: 'Devices', rows: traffic[:devices] %>
  </div>
<% end %>
<div class="grid gap-6 md:grid-cols-5">
  <div class="md:col-span-3 bg-white rounded-2xl border border-base-content/10 p-5 sm:p-6 min-w-0" data-card="campaigns">
    <h4 class="font-semibold">Campaign tags</h4>
    <p class="mt-1 text-sm text-base-content/70">Links that carry a tag, like <span class="font-medium text-base-content">?ct=yt-how-to-sign</span>, followed from the click to the sign-up.</p>
    <% if traffic[:campaigns].empty? %>
      <p class="mt-4 text-sm text-base-content/70" data-empty="campaigns">No tagged links were opened in this period.</p>
    <% else %>
      <%# On a phone the four columns leave no room for the tag itself, so each tag gets a line of its own with its numbers under it. %>
      <ul class="mt-4 divide-y divide-base-content/10 text-sm sm:hidden">
        <% traffic[:campaigns].each do |row| %>
          <li class="py-2.5">
            <p class="font-medium break-words"><%= row[:label] %><% if row[:source] %> <span class="font-normal text-base-content/70">(<%= row[:source] %>)</span><% end %></p>
            <p class="mt-0.5 text-base-content/70"><%= mka_count(row[:views], 'page view') %>, <%= mka_number(row[:signup_opens]) %> opened sign-up, <span class="font-semibold text-base-content"><%= mka_number(row[:signups]) %> signed up</span></p>
          </li>
        <% end %>
      </ul>
      <div class="mt-4 overflow-x-auto hidden sm:block">
        <table class="w-full text-sm text-left">
          <thead class="text-base-content/70">
            <tr>
              <th class="py-1.5 pr-4 font-medium">Tag</th>
              <th class="py-1.5 pr-4 font-medium text-right whitespace-nowrap">Page views</th>
              <th class="py-1.5 pr-4 font-medium text-right whitespace-nowrap">Opened sign-up</th>
              <th class="py-1.5 font-medium text-right whitespace-nowrap">Signed up</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-base-content/10">
            <% traffic[:campaigns].each do |row| %>
              <tr>
                <td class="py-2 pr-4">
                  <span class="font-medium break-words"><%= row[:label] %></span>
                  <% if row[:source] %><span class="block text-xs text-base-content/70"><%= row[:source] %></span><% end %>
                </td>
                <td class="py-2 pr-4 text-right align-top"><%= mka_number(row[:views]) %></td>
                <td class="py-2 pr-4 text-right align-top"><%= mka_number(row[:signup_opens]) %></td>
                <td class="py-2 text-right align-top font-semibold"><%= mka_number(row[:signups]) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-xs text-base-content/70">A tag follows a visitor from the page they land on to the sign-up page only when that is their next click. Sign-ups with Google or Apple are not counted against tags.</p>
    <% end %>
  </div>
  <div class="md:col-span-2 bg-white rounded-2xl border border-base-content/10 p-5 sm:p-6 min-w-0" data-card="signup-opens">
    <h4 class="font-semibold">Sign-up page opened</h4>
    <p class="mt-3 text-4xl font-bold tracking-tight"><%= mka_number(traffic[:signup_opens]) %></p>
    <p class="mt-1 text-sm text-base-content/70">
      <% if traffic[:signup_rate] %>
        <span class="font-semibold text-base-content"><%= number_with_precision(traffic[:signup_rate], precision: 1, strip_insignificant_zeros: true) %></span> for every 100 page views. This is what a click on “Start free” leads to.
      <% else %>
        What a click on “Start free” leads to. The rate appears once there are page views in this period.
      <% end %>
    </p>
    <% if traffic[:signup_opens_by_page].any? %>
      <h5 class="mt-5 text-sm font-medium text-base-content/70">Clicked from</h5>
      <ul class="mt-2 divide-y divide-base-content/10 text-sm">
        <% traffic[:signup_opens_by_page].each do |row| %>
          <li class="py-1.5 flex justify-between gap-3">
            <span class="truncate"><%= row[:label] %></span>
            <span class="flex-none font-semibold"><%= mka_number(row[:value]) %></span>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</div>
