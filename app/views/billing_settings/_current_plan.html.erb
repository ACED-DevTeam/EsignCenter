<%# The card a subscribed account sees: what state the subscription is in,
    when the next thing happens to it, what it costs, and the one door to
    Stripe that can change any of it. %>
<% ends_on = @subscription&.current_period_end %>
<div class="card bg-base-100 border border-base-300" data-billing-card="<%= @view_state %>">
  <div class="card-body p-5 md:p-6 gap-4">
    <div class="flex items-start gap-4">
      <div class="flex-none w-12 h-12 rounded-2xl bg-neutral text-white flex items-center justify-center">
        <%= svg_icon('credit_card', class: 'w-6 h-6') %>
      </div>
      <div class="min-w-0">
        <p class="text-lg font-semibold leading-tight" dir="auto"><%= t("billing_state_#{@view_state}") %></p>
        <p class="text-sm text-base-content/70 mt-1" dir="auto" data-billing-headline>
          <% case @view_state %>
          <% when 'trialing' %>
            <%= @subscription&.trial_end ? t('billing_trial_ends_on', date: l(@subscription.trial_end.to_date, format: :long)) : t('billing_trial_running') %>
          <% when 'canceling' %>
            <%= ends_on ? t('billing_cancels_on', date: l(ends_on.to_date, format: :long)) : t('billing_cancels_at_period_end') %>
          <% when 'past_due' %>
            <%= t('billing_past_due_headline') %>
          <% when 'suspended' %>
            <%= t('billing_suspended_headline') %>
          <% else %>
            <%= ends_on ? t('billing_renews_on', date: l(ends_on.to_date, format: :long)) : t('billing_renews_monthly') %>
          <% end %>
        </p>
      </div>
    </div>

    <dl class="grid grid-cols-1 sm:grid-cols-[auto_1fr] gap-x-6 gap-y-1 text-sm tabular-nums">
      <dt class="text-base-content/70"><%= t('seats_used') %></dt>
      <dd data-billing-seats><%= @seats_in_use %></dd>
      <dt class="text-base-content/70"><%= t('billing_monthly_cost') %></dt>
      <dd data-billing-amount>
        <%= @view_state == 'trialing' ? t('billing_then_amount_per_month', total: @monthly_total, price: @price_per_seat) : t('billing_amount_per_month', total: @monthly_total, price: @price_per_seat) %>
      </dd>
    </dl>

    <% if @view_state == 'trialing' %>
      <p class="text-sm text-base-content/70" dir="auto"><%= t('billing_trial_charge_note') %></p>
    <% elsif @view_state == 'canceling' %>
      <p class="text-sm text-base-content/70" dir="auto"><%= t('billing_resume_hint') %></p>
    <% end %>

    <% if @actionable %>
      <div class="card-actions">
        <%# Stripe answers with a redirect to its own host, so Turbo must stay out of the way. %>
        <%= button_to t('manage_billing'), settings_billing_portal_path,
                      class: 'btn btn-neutral text-white w-full sm:w-auto',
                      form: { class: 'w-full sm:w-auto', data: { turbo: false } },
                      data: { turbo: false, billing_portal_button: true } %>
      </div>
    <% end %>
  </div>
</div>
