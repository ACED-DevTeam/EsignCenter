<%# The card a subscribed account sees: what state the subscription is in,
    when the next thing happens to it, what it costs, and the one door to
    Stripe that can change any of it. %>
<% ends_on = @subscription&.current_period_end %>
<%# Review-6 S3: a subscription set to cancel at period end still ENDS on that
    date even when its state is the payment problem rather than `canceling`
    (Stripe reports a past_due subscription with the flag on, and the state
    card has to say the more useful of the two). Driven off the flag itself,
    never off access_state. %>
<% cancels_on = @subscription&.cancel_at_period_end && ends_on %>
<div class="card bg-base-100 border border-base-300" data-billing-card="<%= @view_state %>">
  <div class="card-body p-5 md:p-6 gap-4">
    <div class="flex items-start gap-4">
      <div class="flex-none w-12 h-12 rounded-2xl bg-neutral text-white flex items-center justify-center">
        <%= svg_icon('credit_card', class: 'w-6 h-6') %>
      </div>
      <div class="min-w-0">
        <p class="text-lg font-semibold leading-tight" dir="auto"><%= t("billing_state_#{@view_state}") %></p>
        <p class="text-sm text-base-content/70 mt-1" dir="auto" data-billing-headline>
          <% case @view_state %>
          <% when 'trialing' %>
            <%= @subscription&.trial_end ? t('billing_trial_ends_on', date: billing_date(@subscription.trial_end)) : t('billing_trial_running') %>
          <% when 'canceling' %>
            <%= cancels_on ? t('billing_cancels_on', date: billing_date(cancels_on)) : t('billing_cancels_at_period_end') %>
          <% when 'incomplete' %>
            <%= t('billing_incomplete_headline') %>
          <% when 'past_due' %>
            <%= cancels_on ? t('billing_cancels_on', date: billing_date(cancels_on)) : t('billing_past_due_headline') %>
          <% when 'suspended' %>
            <%= cancels_on ? t('billing_cancels_on', date: billing_date(cancels_on)) : t('billing_suspended_headline') %>
          <% else %>
            <%= ends_on ? t('billing_renews_on', date: billing_date(ends_on)) : t('billing_renews_monthly') %>
          <% end %>
        </p>
      </div>
    </div>

    <dl class="grid grid-cols-1 sm:grid-cols-[auto_1fr] gap-x-6 gap-y-1 text-sm tabular-nums">
      <dt class="text-base-content/70"><%= t('billing_seats_billed_label') %></dt>
      <dd data-billing-seats><%= @billed_seats %></dd>
      <dt class="text-base-content/70"><%= t('billing_monthly_cost') %></dt>
      <dd data-billing-amount>
        <%= @view_state == 'trialing' ? t('billing_then_amount_per_month', total: @monthly_total, price: @price_per_seat) : t('billing_amount_per_month', total: @monthly_total, price: @price_per_seat) %>
      </dd>
    </dl>

    <%# Seats are frozen at Checkout, so the people in the account can differ
        from the seats Stripe bills; the card says both rather than quoting a
        number the invoice will not match — and names the invitations that are
        holding a seat for somebody who has not arrived yet. %>
    <% if @billed_seats %>
      <p class="text-sm text-base-content/70" dir="auto" data-billing-seats-in-use>
        <% if @pending_invites_count.to_i.positive? %>
          <%= t('billing_seats_summary_pending', seats: @billed_seats, in_use: @seats_in_use, pending: @pending_invites_count) %>
        <% else %>
          <%= t('billing_seats_summary', seats: @billed_seats, in_use: @seats_in_use) %>
        <% end %>
        <%= link_to t('billing_manage_users_link'), settings_users_path, class: 'link' %>
      </p>
    <% end %>

    <% if @view_state == 'trialing' %>
      <p class="text-sm text-base-content/70" dir="auto"><%= t('billing_trial_charge_note') %></p>
    <% elsif @view_state == 'canceling' %>
      <p class="text-sm text-base-content/70" dir="auto"><%= t('billing_resume_hint') %></p>
    <% end %>

    <% if @actionable %>
      <div class="card-actions">
        <%# Stripe answers with a redirect to its own host, so Turbo must stay out of the way. %>
        <%= button_to t('manage_billing'), settings_billing_portal_path,
                      class: 'btn btn-neutral text-white w-full sm:w-auto',
                      form: { class: 'w-full sm:w-auto', data: { turbo: false } },
                      data: { turbo: false, billing_portal_button: true } %>
      </div>
    <% end %>
  </div>
</div>
