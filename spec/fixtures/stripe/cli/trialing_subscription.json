{
  "_meta": { "template_version": 0 },
  "fixtures": [
    {
      "name": "customer",
      "path": "/v1/customers",
      "method": "post",
      "params": {
        "email": "fixture@example.com",
        "name": "EsignCenter Fixture Co",
        "description": "spec/fixtures/stripe capture - safe to delete",
        "metadata": { "account_id": "424242" }
      }
    },
    {
      "name": "payment_method",
      "path": "/v1/payment_methods",
