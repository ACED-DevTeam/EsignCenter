        "trial_period_days": "14",
        "trial_settings": { "end_behavior": { "missing_payment_method": "cancel" } },
        "payment_behavior": "default_incomplete",
        "metadata": { "account_id": "424242" },
        "expand": ["items.data.price"]
      }
